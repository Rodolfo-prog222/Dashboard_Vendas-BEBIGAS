# Copie este arquivo para ".env.local" (uso local) e configure as mesmas
# variáveis nas "Environment Variables" do projeto na Vercel.

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE

# Apenas se algum Route Handler/Server Action precisar ignorar RLS.
# NUNCA prefixar com NEXT_PUBLIC_ e nunca expor no navegador.
# SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
